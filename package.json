{
  "name": "gym-flow-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "convert:webp": "node scripts/convert-to-webp.js",
    "convert:webp:force": "node scripts/convert-to-webp.js --force",
    "convert:webp:hires": "node scripts/convert-to-webp.js --hires",
    "media:index": "node scripts/generate-media-index.js",
    "media:pipeline": "node scripts/convert-to-webp.js && node scripts/generate-media-index.js",
    "media:sync": "node scripts/sync-exercises-to-supabase.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.97.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.33",
    "expo-camera": "^55.0.16",
    "expo-constants": "~18.0.13",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.5.1",
    "react-refresh": "^0.18.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "minimist": "^1.2.8",
    "sharp": "^0.34.5",
    "tailwindcss": "~3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
