# pnpm configuration for Gym Flow App
# https://pnpm.io/npmrc

# Expo / React Native require hoisted modules for Metro bundler resolution
node-linker=hoisted

# Shamefully hoist all packages (needed for Expo/Metro compatibility)
shamefully-hoist=true

# Don't prompt for peer dependency installation automatically
auto-install-peers=true

# Strict peer dependency checking (warn only, don't fail)
strict-peer-dependencies=false

# Save exact versions by default
save-exact=false
